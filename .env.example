# realtime_cli.py 설정값 — 실시간 델타를 뺀 나머지 소스층을 여기서 고정한다.
# 셸에서 RT_FAN=... python3 realtime_cli.py 로 일시 override 가능 (셸 > .env).

# 유저 팬심(누적)
RT_FAN=1500

# 친밀도 (고정)
RT_INTIMACY=7

# 팔로우 팀: 100 또는 200 (raw data 의 두 팀 중 하나)
RT_FOLLOW_TEAM=100

# 이벤트 재생 간격(초)
RT_TICK_SECONDS=10

# 0 = 전부 (미리보기용 제한)
RT_MAX_EVENTS=0

# 감쇠용 턴 간격
RT_DT=1.0

# 1 = 원본 Arbiter 로그 동봉
RT_VERBOSE=0
